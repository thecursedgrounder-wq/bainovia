--- !u!114 &1797434654
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1797434653}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 843ddef9f52e80e4da027d3d0b5c11fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  dialogueNodes:
  - nodeId: greeting
    speakerName: Rune Scholar
    dialogueText: The storm runes grow restless, Storm-Breaker. A Frost Brute has
      wandered near the canyon camp. Hunt it, and I will share the shrine's secrets
      with you.
    options:
    - optionText: I will hunt it.
      nextNodeId: accept
      requiredReputation: 0
      requiredFaction: 
      requiresSpiritInsight: 0
      givesReputation: 0
      reputationAmount: 0
      reputationFaction: 
      givesQuest: 1
      questId: protect_camp
      endsDialogue: 1
    - optionText: Tell me of the old shrine.
      nextNodeId: shrine
      requiredReputation: 0
      requiredFaction: 
      requiresSpiritInsight: 0
      givesReputation: 0
      reputationAmount: 0
      reputationFaction: 
      givesQuest: 0
      questId: 
      endsDialogue: 0
    - optionText: Another time.
      nextNodeId: 
      requiredReputation: 0
      requiredFaction: 
      requiresSpiritInsight: 0
      givesReputation: 0
      reputationAmount: 0
      reputationFaction: 
      givesQuest: 0
      questId: 
      endsDialogue: 1
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
  - nodeId: accept
    speakerName: Rune Scholar
    dialogueText: May the old spirits guide your claws.
    options:
    - optionText: Farewell.
      nextNodeId: 
      requiredReputation: 0
      requiredFaction: 
      requiresSpiritInsight: 0
      givesReputation: 0
      reputationAmount: 0
      reputationFaction: 
      givesQuest: 0
      questId: 
      endsDialogue: 1
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
  - nodeId: shrine
    speakerName: Rune Scholar
    dialogueText: Beyond the columns, the Restless Shrine wakes. Gather three rune
      fragments from the canyon floor and it may calm.
    options:
    - optionText: I will gather them.
      nextNodeId: 
      requiredReputation: 0
      requiredFaction: 
      requiresSpiritInsight: 0
      givesReputation: 0
      reputationAmount: 0
      reputationFaction: 
      givesQuest: 1
      questId: restless_shrine
      endsDialogue: 1
    - optionText: Perhaps later.
      nextNodeId: 
      requiredReputation: 0
      requiredFaction: 
      requiresSpiritInsight: 0
      givesReputation: 0
      reputationAmount: 0
      reputationFaction: 
      givesQuest: 0
      questId: 
      endsDialogue: 1
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
